{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.gobii/remote-mcp",
  "title": "Gobii Remote MCP",
  "description": "Create, manage, message, coordinate, and inspect persistent AI agents from MCP clients.",
  "websiteUrl": "https://docs.gobii.ai/developers/mcp-server",
  "repository": {
    "url": "https://github.com/gobii-ai/gobii-platform",
    "source": "github"
  },
  "version": "2.19.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://gobii.ai/api/v1/mcp/",
      "headers": [
        {
          "name": "X-Api-Key",
          "description": "Gobii API key",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
